# ============================================================================
# VeyraOS Environment Variables (Template / Placeholder Only)
# Salin berkas ini ke .env.local untuk konfigurasi pengembangan lokal.
# DILARANG mengisi atau mengunggah kredensial/kunci rahasia asli ke repository.
# ============================================================================

# Supabase Public API Configuration (Tersedia di Browser dan Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder

# Fallback kompatibilitas anon key lama (opsional jika publishable key sudah diisi)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Server-Only Configuration (TIDAK BOLEH menggunakan awalan NEXT_PUBLIC_)
# ============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
